    "# ── Section 2.7: validation\n",
    "def check(ok, label):\n",
    "    print(f\"  {'PASS' if ok else 'FAIL'}  {label}\")\n",
    "    return bool(ok)\n",
    "\n",
    "\n",
    "all_ok = True\n",
    "for year in range(YEAR_START, YEAR_END + 1):\n",
    "    path = DATA_DIR / f\"hazard_catalogue_{year}.parquet\"\n",
    "    if not path.exists():\n",
    "        print(f\"{year}: no catalogue file (year skipped above)\")\n",
    "        continue\n",
    "    try:\n",
    "        df = pd.read_parquet(path)\n",
    "    except Exception as exc:\n",
    "        print(f\"{year}: cannot read {path}: {exc}\")\n",
    "        all_ok = False\n",
    "        continue\n",
    "\n",
    "    missing = [c for c in CONTRACT_COLS if c not in df.columns]\n",
    "    if missing:\n",
    "        print(f\"SCHEMA ERROR {year}: missing columns {missing}\")\n",
    "        all_ok = False\n",
    "        continue\n",
    "    print(f\"{year}: schema OK — {len(df)} events, \"\n",
    "          f\"{int(df['flag_heave'].sum())} heave flags, {int(df['flag_rogue'].sum())} rogue flags\")\n",
    "\n",
    "    all_ok &= check(df[\"event_id\"].is_unique, \"event_id unique\")\n",
    "    all_ok &= check(df[\"lon\"].between(-70, -5).all(), \"lon in [-70, -5]\")\n",
    "    all_ok &= check(df[\"lat\"].between(30, 65).all(), \"lat in [30, 65]\")\n",
    "    all_ok &= check((df[\"Hs_cmems\"] >= 0).all(), \"Hs_cmems >= 0\")\n",
    "    all_ok &= check(isinstance(df[\"datetime\"].dtype, pd.DatetimeTZDtype)\n",
    "                    and str(df[\"datetime\"].dt.tz) == \"UTC\", \"datetime tz-aware UTC\")\n",
    "    all_ok &= check(df[\"datetime\"].dt.year.eq(year).all(), f\"all events in {year}\")\n",
    "    all_ok &= check(df[\"flag_any\"].all(), \"every row flagged\")\n",
    "    all_ok &= check(df[\"route_seg_idx\"].between(0, N_ROUTE_PTS - 1).all(), \"route_seg_idx valid\")\n",
    "    all_ok &= check(df[\"lon_bin\"].isin(LON_BIN_LABELS).all(), \"lon_bin labels valid\")\n",
    "    if len(df):\n",
    "        print(f\"  Hs range: {df['Hs_cmems'].min():.2f}–{df['Hs_cmems'].max():.2f} m | \"\n",
    "              f\"U10_era5 coverage: {100 * df['U10_era5'].notna().mean():.0f} %\")\n",
    "\n",
    "print(f\"\\nValidation {'PASSED' if all_ok else 'FAILED — see FAIL lines above'}.\")"
