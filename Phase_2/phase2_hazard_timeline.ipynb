    "# ── Section 2.1: data inventory\n",
    "def open_found(meta):\n",
    "    # Open one inventoried NetCDF (plain file, or a member of a CDS zip archive)\n",
    "    if meta[\"member\"] is None:\n",
    "        return xr.open_dataset(meta[\"path\"], engine=\"netcdf4\")\n",
    "    return xr.open_dataset(zipfile.ZipFile(meta[\"path\"]).open(meta[\"member\"]), engine=\"h5netcdf\")\n",
    "\n",
    "\n",
    "def _nc_sources(path):\n",
    "    # (key, path, member) for a .nc file — a CDS zip yields one entry per inner NetCDF\n",
    "    if zipfile.is_zipfile(path):\n",
    "        with zipfile.ZipFile(path) as z:\n",
    "            return [(f\"{path.name}::{m}\", path, m) for m in z.namelist() if m.endswith(\".nc\")]\n",
    "    return [(path.name, path, None)]\n",
    "\n",
    "\n",
    "for d in SEARCH_DIRS:\n",
    "    print(f\"{d}/ : {sorted(os.listdir(d)) if d.exists() else 'MISSING'}\")\n",
    "\n",
    "FOUND_FILES = {}\n",
    "nc_paths = sorted(p for d in SEARCH_DIRS if d.exists() for p in d.glob(\"*.nc\"))\n",
    "for f in tqdm(nc_paths, desc=\"inventory\"):\n",
    "    try:\n",
    "        sources = _nc_sources(f)\n",
    "    except Exception as exc:\n",
    "        print(f\"WARNING: cannot read {f}: {exc}\")\n",
    "        continue\n",
    "    for key, path, member in sources:\n",
    "        meta = {\"path\": path, \"member\": member}\n",
    "        try:\n",
    "            ds = open_found(meta)\n",
    "        except Exception as exc:\n",
    "            print(f\"WARNING: cannot open {key}: {exc}\")\n",
    "            continue\n",
    "        time_name = next((t for t in TIME_CANDIDATES if t in ds.coords), None)\n",
    "        if time_name is not None:\n",
    "            tv = ds.coords[time_name].values\n",
    "            time_range = (str(tv[0]), str(tv[-1]))\n",
    "        else:\n",
    "            time_range = (None, None)\n",
    "        FOUND_FILES[key] = {\n",
    "            **meta,\n",
    "            \"vars\":       list(ds.data_vars),\n",
    "            \"dims\":       dict(ds.sizes),\n",
    "            \"coords\":     list(ds.coords),\n",
    "            \"time_name\":  time_name,\n",
    "            \"time_range\": time_range,\n",
    "        }\n",
    "        ds.close()\n",
    "\n",
    "for key, meta in FOUND_FILES.items():\n",
    "    print(f\"\\n{meta['path'].parent.name}/{key}\")\n",
    "    print(f\"  vars : {meta['vars']}\")\n",
    "    print(f\"  dims : {meta['dims']}\")\n",
    "    print(f\"  time : {meta['time_range'][0]}  →  {meta['time_range'][1]}  ({meta['time_name']})\")\n",
    "\n",
    "if not FOUND_FILES:\n",
    "    print(\"WARNING: no .nc files found in SEARCH_DIRS. \"\n",
    "          \"Will attempt live CMEMS download in Section 2.2.\")"
   ]
  },
