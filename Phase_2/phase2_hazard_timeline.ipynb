   "metadata": {},
   "source": [
    "## 2.2 Load Wave Reanalysis (Hs, T0)\n",
    "\n",
    "Local file first (variable names resolved from `FOUND_FILES`; a file with both Hs and a peak\n",
    "period is preferred over Hs-only products such as the L4 altimetry grid). If no local file covers\n",
    "the year, the data is streamed from CMEMS with `copernicusmarine`. Any failure returns `None`\n",
    "and the year is skipped."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "8c511066",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Section 2.2: wave reanalysis loader\n",
    "def _standardise(ds):\n",
    "    # Rename time / lat / lon coordinates to time, latitude, longitude\n",
    "    rename = {}\n",
    "    for std, cands in ((\"time\", TIME_CANDIDATES), (\"latitude\", [\"lat\", \"latitude\"]),\n",
    "                       (\"longitude\", [\"lon\", \"longitude\"])):\n",
    "        for c in cands:\n",
    "            if c in ds.coords and c != std and std not in ds.coords:\n",
    "                rename[c] = std\n",
    "                break\n",
    "    return ds.rename(rename)\n",
    "\n",
    "\n",
    "def load_wave_reanalysis(year, found_files, data_dir, route_lons, route_lats):\n",
    "    '''\n",
    "    Try to load Hs and T0 from a local .nc file first.\n",
    "    Hs / T0 variable names are taken from found_files (HS_CANDIDATES, T0_CANDIDATES).\n",
    "    If no local file covers this year, download via copernicusmarine.\n",
    "\n",
    "    Returns xarray Dataset with coords time, latitude, longitude and\n",
    "    data_vars Hs, T0 (T0 all-NaN if no period variable exists), or None.\n",
    "    '''\n",
    "    # ── 1. Local files covering the year, those with a peak period first\n",
    "    local = [(k, m) for k, m in found_files.items()\n",
    "             if year in file_years(m) and first_var(m, HS_CANDIDATES)]\n",
    "    local.sort(key=lambda km: first_var(km[1], T0_CANDIDATES) is None)\n",
    "\n",
    "    ds, hs_var, t0_var = None, None, None\n",
    "    for key, meta in local:\n",
    "        try:\n",
    "            ds = open_found(meta)\n",
    "            hs_var = first_var(meta, HS_CANDIDATES)\n",
    "            t0_var = first_var(meta, T0_CANDIDATES) or first_var(meta, T0_FALLBACKS)\n",
    "            print(f\"[wave] {year}: {key}  (Hs={hs_var}, T0={t0_var})\")\n",
    "            break\n",
    "        except Exception as exc:\n",
    "            print(f\"[wave] {year}: could not open {key}: {exc}\")\n",
    "            ds = None\n",
    "\n",
    "    # ── 2. Fall back to live download\n",
    "    if ds is None:\n",
    "        if CMEMS_USER == \"YOUR_USERNAME\":\n",
    "            print(f\"[wave] {year}: no local file and no CMEMS credentials — skipping year.\")\n",
    "            return None\n",
    "        print(f\"[wave] {year}: no local wave file. Streaming {WAVE_DATASET_ID} from CMEMS...\")\n",
    "        try:\n",
    "            import copernicusmarine as cm\n",
    "            ds = cm.open_dataset(\n",
    "                dataset_id        = WAVE_DATASET_ID,\n",
    "                variables         = [\"VHM0\", \"VTPK\"],\n",
    "                minimum_longitude = float(route_lons.min()) - 2,\n",
    "                maximum_longitude = float(route_lons.max()) + 2,\n",
    "                minimum_latitude  = float(route_lats.min()) - 2,\n",
    "                maximum_latitude  = float(route_lats.max()) + 2,\n",
    "                start_datetime    = f\"{year}-01-01T00:00:00\",\n",
    "                end_datetime      = f\"{year}-12-31T21:00:00\",\n",
    "                username = CMEMS_USER, password = CMEMS_PASS,\n",
    "            )\n",
    "            hs_var, t0_var = \"VHM0\", \"VTPK\"\n",
    "        except Exception as exc:\n",
    "            print(f\"[wave] {year}: CMEMS download failed ({exc}) — skipping year.\")\n",
    "            return None\n",
    "\n",
    "    if t0_var is not None and t0_var not in T0_CANDIDATES:\n",
    "        print(f\"[wave] {year}: WARNING no peak period found; T0 taken from mean period {t0_var}.\")\n",
    "    elif t0_var is None:\n",
    "        print(f\"[wave] {year}: WARNING no period variable found; T0_cmems will be NaN.\")\n",
    "\n",
    "    # ── 3. Keep Hs / T0 for this year only, standard names\n",
    "    ds = _standardise(ds)\n",
    "    out = ds[[hs_var]].rename({hs_var: \"Hs\"})\n",
    "    out[\"T0\"] = ds[t0_var] if t0_var else xr.full_like(ds[hs_var], np.nan)\n",
    "    out = out.sel(time=str(year))\n",
    "    if out.sizes.get(\"time\", 0) == 0:\n",
    "        print(f\"[wave] {year}: file has no time steps in {year} — skipping year.\")\n",
    "        return None\n",
    "    return out"
   ]
  },
