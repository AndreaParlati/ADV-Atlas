    "# ── Section 2.1b: which file serves which role, per year\n",
    "def file_years(meta):\n",
    "    # Calendar years covered by an inventoried file (empty if it has no time axis)\n",
    "    t0, t1 = meta[\"time_range\"]\n",
    "    if t0 is None:\n",
    "        return range(0)\n",
    "    return range(pd.Timestamp(t0).year, pd.Timestamp(t1).year + 1)\n",
    "\n",
    "\n",
    "def first_var(meta, candidates):\n",
    "    return next((v for v in candidates if v in meta[\"vars\"]), None)\n",
    "\n",
    "\n",
    "coverage = []\n",
    "for year in range(YEAR_START, YEAR_END + 1):\n",
    "    wave = [k for k, m in FOUND_FILES.items()\n",
    "            if year in file_years(m) and first_var(m, HS_CANDIDATES)]\n",
    "    wind = [k for k, m in FOUND_FILES.items()\n",
    "            if year in file_years(m) and all(v in m[\"vars\"] for v in WIND_U_V)]\n",
    "    coverage.append({\"year\": year, \"wave_files\": len(wave), \"era5_wind_files\": len(wind)})\n",
    "coverage = pd.DataFrame(coverage).set_index(\"year\")\n",
    "print(coverage.to_string())\n",
    "missing_wind = coverage.index[coverage[\"era5_wind_files\"] < 12].tolist()\n",
    "if missing_wind:\n",
    "    print(f\"\\nNOTE: ERA5 wind incomplete (< 12 monthly files) for {missing_wind}: \"\n",
    "          \"U10_era5 will be NaN for the uncovered months.\")"
   ]
