    "# ── Section 2.8: diagnostics\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.dates as mdates\n",
    "\n",
    "cat_path = DATA_DIR / f\"hazard_catalogue_{YEAR_START}.parquet\"\n",
    "if YEAR_START not in ROUTE_BY_YEAR or not cat_path.exists():\n",
    "    print(f\"No processed data for {YEAR_START} — diagnostics skipped.\")\n",
    "else:\n",
    "    df_plot = pd.read_parquet(cat_path)\n",
    "    route_df = ROUTE_BY_YEAR[YEAR_START]\n",
    "    fig, axes = plt.subplots(2, 2, figsize=(14, 9))\n",
    "\n",
    "    # Plot 1: Hs time series at mid-route point with hazard thresholds\n",
    "    mid = N_ROUTE_PTS // 2\n",
    "    mid_data = route_df[route_df[\"route_seg_idx\"] == mid]\n",
    "    ax = axes[0, 0]\n",
    "    ax.plot(pd.to_datetime(mid_data[\"time\"]), mid_data[\"Hs\"], lw=0.8, color=\"#2a78d6\", label=\"Hs\")\n",
    "    ax.axhline(HEAVE_THRESH_M, color=\"#d03b3b\", ls=\"--\", lw=1, label=f\"heave thresh {HEAVE_THRESH_M} m\")\n",
    "    ax.axhline(ROGUE_HS_PROXY, color=\"#e08a00\", ls=\"--\", lw=1, label=f\"rogue proxy {ROGUE_HS_PROXY} m\")\n",
    "    ax.set_title(f\"Hs at mid-route ({ROUTE_LONS[mid]:.1f}°E, {ROUTE_LATS[mid]:.1f}°N)\")\n",
    "    ax.set_ylabel(\"Hs [m]\"); ax.legend(fontsize=7)\n",
    "    ax.xaxis.set_major_formatter(mdates.DateFormatter(\"%b\"))\n",
    "\n",
    "    # Plot 2: Events per month\n",
    "    ax = axes[0, 1]\n",
    "    (df_plot[\"datetime\"].dt.month.value_counts().reindex(range(1, 13), fill_value=0)\n",
    "     .plot(kind=\"bar\", ax=ax, color=\"#2a78d6\"))\n",
    "    ax.set_title(\"Hazard events per month\")\n",
    "    ax.set_xlabel(\"Month\"); ax.set_ylabel(\"N events\")\n",
    "\n",
    "    # Plot 3: Spatial distribution along route\n",
    "    ax = axes[1, 0]\n",
    "    sc = ax.scatter(df_plot[\"lon\"], df_plot[\"lat\"], c=df_plot[\"Hs_cmems\"],\n",
    "                    cmap=\"plasma\", s=8, alpha=0.6)\n",
    "    ax.plot(ROUTE_LONS, ROUTE_LATS, \"k--\", lw=0.7, alpha=0.4, label=\"route\")\n",
    "    ax.set_title(\"Hazard event locations\")\n",
    "    ax.set_xlabel(\"Longitude [°E]\"); ax.set_ylabel(\"Latitude [°N]\")\n",
    "    ax.legend(fontsize=7)\n",
    "    plt.colorbar(sc, ax=ax, label=\"Hs [m]\")\n",
    "\n",
    "    # Plot 4: Events per lon_bin, west → east\n",
    "    ax = axes[1, 1]\n",
    "    (df_plot[\"lon_bin\"].value_counts().reindex(LON_BIN_LABELS, fill_value=0)\n",
    "     .plot(kind=\"bar\", ax=ax, color=\"#1a9a8a\"))\n",
    "    ax.set_title(\"Events per 5° longitude bin\")\n",
    "    ax.set_xlabel(\"Lon bin\"); ax.set_ylabel(\"N events\")\n",
    "    ax.tick_params(axis=\"x\", labelsize=7, rotation=45)\n",
    "\n",
    "    plt.suptitle(f\"Phase 2 — Hazard Timeline {YEAR_START}\", fontsize=13, fontweight=\"bold\")\n",
    "    plt.tight_layout()\n",
