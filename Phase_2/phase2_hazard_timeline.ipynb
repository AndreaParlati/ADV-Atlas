    "# ── Section 2.6: build and save the catalogue\n",
    "CONTRACT_COLS = [\"event_id\", \"datetime\", \"lon\", \"lat\",\n",
    "                 \"Hs_cmems\", \"T0_cmems\", \"U10_era5\",\n",
    "                 \"flag_heave\", \"flag_rogue\", \"flag_any\",\n",
    "                 \"route_seg_idx\", \"lon_bin\"]\n",
    "COMPAT_COLS = [\"flag_reason\"]        # read by phase3_coincidence (value_counts)\n",
    "\n",
    "LON_BIN_LABELS = [f\"{int(LON_BIN_EDGES[i])}_{int(LON_BIN_EDGES[i + 1])}\"\n",
    "                  for i in range(len(LON_BIN_EDGES) - 1)]\n",
    "\n",
    "\n",
    "def build_catalogue(df, year):\n",
    "    '''\n",
    "    Filter to flagged events, assign event_id and lon_bin, and enforce the\n",
    "    parquet schema contract expected by phase3_coincidence.ipynb.\n",
    "    '''\n",
    "    flagged = (df[df[\"flag_any\"]].sort_values([\"time\", \"route_seg_idx\"])\n",
    "               .reset_index(drop=True)\n",
    "               .rename(columns={\"time\": \"datetime\", \"Hs\": \"Hs_cmems\", \"T0\": \"T0_cmems\"}))\n",
    "    flagged.insert(0, \"event_id\", [f\"{year}_{i:05d}\" for i in range(len(flagged))])\n",
    "    flagged[\"datetime\"] = pd.to_datetime(flagged[\"datetime\"], utc=True)\n",
    "    flagged[\"lon_bin\"] = pd.cut(flagged[\"lon\"], bins=LON_BIN_EDGES,\n",
    "                                labels=LON_BIN_LABELS, right=False).astype(str)\n",
    "    flagged[\"flag_reason\"] = np.where(flagged[\"flag_rogue\"], \"heave_proxy+rogue_proxy\", \"heave_proxy\")\n",
    "\n",
    "    for col in [\"U10_era5\", \"T0_cmems\"]:\n",
    "        if col not in flagged.columns:\n",
    "            flagged[col] = np.nan\n",
    "    flagged[\"route_seg_idx\"] = flagged[\"route_seg_idx\"].astype(\"int64\")\n",
    "    for col in [\"lon\", \"lat\", \"Hs_cmems\", \"T0_cmems\", \"U10_era5\"]:\n",
    "        flagged[col] = flagged[col].astype(\"float64\")\n",
    "    return flagged[CONTRACT_COLS + COMPAT_COLS]\n",
    "\n",
    "\n",
    "ROUTE_BY_YEAR, SUMMARY = {}, []\n",
    "for year in range(YEAR_START, YEAR_END + 1):\n",
    "    print(f\"\\n════ {year} ════\")\n",
    "    try:\n",
    "        wave_ds = load_wave_reanalysis(year, FOUND_FILES, DATA_DIR, ROUTE_LONS, ROUTE_LATS)\n",
    "        if wave_ds is None:\n",
    "            continue\n",
    "        route_df = interpolate_along_route(wave_ds, ROUTE_LONS, ROUTE_LATS)\n",
    "        wave_ds.close()\n",
    "        n_nan = int(route_df[\"Hs\"].isna().sum())\n",
    "        if n_nan:\n",
    "            print(f\"[route] {year}: WARNING {n_nan} records with NaN Hs (never flagged).\")\n",
    "\n",
    "        route_df = attach_wind(route_df,\n",
    "                               load_wind_speed(year, FOUND_FILES, DATA_DIR, ROUTE_LONS, ROUTE_LATS))\n",
    "        route_df = apply_hazard_flags(route_df, HEAVE_THRESH_M, ROGUE_HS_PROXY)\n",
    "        ROUTE_BY_YEAR[year] = route_df\n",
    "\n",
    "        n_total, n_hazard = len(route_df), int(route_df[\"flag_any\"].sum())\n",
    "        print(f\"[flag] {year}: {n_total} route-timestep records, \"\n",
    "              f\"{n_hazard} hazardous ({100 * n_hazard / max(n_total, 1):.1f} %)\")\n",
    "\n",
    "        cat = build_catalogue(route_df, year)\n",
    "        out_path = DATA_DIR / f\"hazard_catalogue_{year}.parquet\"\n",
    "        cat.to_parquet(out_path, index=False, engine=\"pyarrow\")\n",
    "        print(f\"[save] {year}: {len(cat)} events → {out_path}\")\n",
    "        SUMMARY.append({\"year\": year, \"n_records\": n_total, \"n_events\": len(cat),\n",
    "                        \"n_heave\": int(cat[\"flag_heave\"].sum()),\n",
    "                        \"n_rogue\": int(cat[\"flag_rogue\"].sum()),\n",
    "                        \"Hs_max\": cat[\"Hs_cmems\"].max(),\n",
    "                        \"U10_coverage_%\": 100 * cat[\"U10_era5\"].notna().mean() if len(cat) else np.nan})\n",
    "    except Exception as exc:\n",
    "        print(f\"[error] {year}: {type(exc).__name__}: {exc} — year skipped.\")\n",
    "\n",
    "SUMMARY = pd.DataFrame(SUMMARY)\n",
    "print(\"\\n\" + (SUMMARY.to_string(index=False) if len(SUMMARY) else \"No year was processed.\"))"
   ]
  },
