   "source": [
    "## 2.3 Interpolate Hs and T0 onto Route Waypoints\n",
    "\n",
    "Vectorised bilinear interpolation onto the `N_ROUTE_PTS` waypoints for every time step.\n",
    "Waypoints whose interpolation stencil touches a land/NaN cell take the **nearest-neighbour\n",
    "value at the same waypoint** (no filling across waypoints or time)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "e23214ac",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Section 2.3: interpolation onto the route\n",
    "def interpolate_along_route(ds, route_lons, route_lats, var_names=(\"Hs\", \"T0\")):\n",
    "    '''\n",
    "    Interpolate ds variables onto the route waypoints at every time step.\n",
    "    Returns a long DataFrame: time, route_seg_idx, lon, lat, *var_names\n",
    "    (variables missing from ds are returned as NaN with a warning).\n",
    "    '''\n",
    "    present = [v for v in var_names if v in ds.data_vars]\n",
    "    for v in set(var_names) - set(present):\n",
    "        print(f\"[interp] WARNING: {v} not in dataset — column filled with NaN.\")\n",
    "    pts = dict(longitude=xr.DataArray(np.asarray(route_lons, float), dims=\"route_seg_idx\"),\n",
    "               latitude=xr.DataArray(np.asarray(route_lats, float), dims=\"route_seg_idx\"))\n",
    "    sub = ds[present].load()\n",
    "    on_route = sub.interp(**pts, method=\"linear\")\n",
    "    on_route = on_route.fillna(sub.sel(**pts, method=\"nearest\"))\n",
    "    on_route = on_route.drop_vars([\"longitude\", \"latitude\"], errors=\"ignore\")\n",
    "\n",
    "    # Waypoints whose nearest cell is land (e.g. Halifax harbour): use the nearest ocean cell\n",
    "    for v in present:\n",
    "        da = sub[v]\n",
    "        empty = np.flatnonzero(on_route[v].isnull().all(\"time\").values)\n",
    "        if not len(empty):\n",
    "            continue\n",
    "        ocean = da.notnull().any(\"time\")\n",
    "        glat, glon = xr.broadcast(da[\"latitude\"], da[\"longitude\"])\n",
    "        olat, olon = glat.values[ocean.values], glon.values[ocean.values]\n",
    "        for j in empty:\n",
    "            lon_j, lat_j = float(route_lons[j]), float(route_lats[j])\n",
    "            k = np.argmin((olat - lat_j) ** 2 + ((olon - lon_j) * np.cos(np.radians(lat_j))) ** 2)\n",
    "            series = da.sel(latitude=olat[k], longitude=olon[k])\n",
    "            on_route[v].loc[dict(route_seg_idx=j)] = series.values\n",
    "            print(f\"[interp] {v}: waypoint {j} ({lon_j:.2f}, {lat_j:.2f}) on land — \"\n",
    "                  f\"using nearest ocean cell ({olon[k]:.2f}, {olat[k]:.2f})\")\n",
    "\n",
    "    df = on_route.to_dataframe().reset_index()\n",
    "    for v in var_names:\n",
    "        if v not in df.columns:\n",
    "            df[v] = np.nan\n",
    "    df[\"lon\"] = np.asarray(route_lons, float)[df[\"route_seg_idx\"]]\n",
    "    df[\"lat\"] = np.asarray(route_lats, float)[df[\"route_seg_idx\"]]\n",
    "    return df[[\"time\", \"route_seg_idx\", \"lon\", \"lat\", *var_names]]"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "66f3bf20",
   "metadata": {},
   "source": [
    "## 2.4 Wind Speed (ERA5 or CMEMS fallback)\n",
    "\n",
    "ERA5 hourly `u10`/`v10` (monthly CDS zip files in `ERA5/`) are sub-sampled to the 3-hourly\n",
    "wave time steps, converted to $|U_{10}| = \\sqrt{u_{10}^2 + v_{10}^2}$ and interpolated onto the route.\n",
    "\n",
    "**Fallback:** the CMEMS wave reanalysis contains no wind-speed field (`VHM0_WW` / `VMDR_WW` are\n",
    "wind-*sea* height and direction, not wind speed), so no CMEMS substitute is fabricated:\n",
    "months without ERA5 coverage get `U10_era5 = NaN`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "9d8c1b5a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Section 2.4: ERA5 10-m wind speed\n",
    "def load_wind_speed(year, found_files, data_dir, route_lons, route_lats):\n",
    "    '''\n",
    "    Find local ERA5 files with u10/v10 covering `year` (variable names from found_files),\n",
    "    compute |U10| on the 3-hourly grid and interpolate it onto the route.\n",
    "    Returns DataFrame (time, route_seg_idx, U10) or None if no wind data exists.\n",
    "    '''\n",
    "    u_var, v_var = WIND_U_V\n",
    "    files = [(k, m) for k, m in found_files.items()\n",
    "             if year in file_years(m) and u_var in m[\"vars\"] and v_var in m[\"vars\"]]\n",
    "    if not files:\n",
    "        print(f\"[wind] {year}: no ERA5 wind file found. U10_era5 will be NaN. \"\n",
    "              \"Download ERA5 with the CDS API to enable the wind term of the Phase 1 pipeline.\")\n",
    "        return None\n",
    "\n",
    "    parts = []\n",
    "    for key, meta in sorted(files, key=lambda km: km[1][\"time_range\"][0]):\n",
    "        try:\n",
    "            ds = _standardise(open_found(meta))\n",
    "            ds = ds.sel(time=str(year))\n",
    "            ds = ds.isel(time=np.flatnonzero(ds[\"time\"].dt.hour.values % 3 == 0))  # 3-hourly wave steps\n",
    "            u, v = ds[u_var], ds[v_var]\n",
    "            if \"number\" in u.dims:                                # ensemble member dim, if any\n",
    "                u, v = u.isel(number=0), v.isel(number=0)\n",
    "            wind = xr.Dataset({\"U10\": np.sqrt(u**2 + v**2)})\n",
    "            parts.append(interpolate_along_route(wind, route_lons, route_lats, var_names=[\"U10\"]))\n",
    "            ds.close()\n",
    "        except Exception as exc:\n",
    "            print(f\"[wind] {year}: failed on {key}: {exc}\")\n",
    "    if not parts:\n",
    "        return None\n",
    "    wind_df = pd.concat(parts, ignore_index=True).drop_duplicates([\"time\", \"route_seg_idx\"])\n",
    "    months = sorted(int(m) for m in pd.to_datetime(wind_df[\"time\"]).dt.month.unique())\n",
    "    print(f\"[wind] {year}: ERA5 U10 for {len(months)}/12 months {months if len(months) < 12 else ''}\")\n",
    "    return wind_df[[\"time\", \"route_seg_idx\", \"U10\"]]\n",
    "\n",
    "\n",
    "def attach_wind(route_df, wind_df):\n",
    "    # Left-join U10 onto the route table as U10_era5 (NaN where ERA5 is missing)\n",
    "    if wind_df is None:\n",
    "        out = route_df.copy()\n",
    "        out[\"U10_era5\"] = np.nan\n",
    "        return out\n",
    "    out = route_df.merge(wind_df, on=[\"time\", \"route_seg_idx\"], how=\"left\")\n",
    "    return out.rename(columns={\"U10\": \"U10_era5\"})"
   ]
  },
