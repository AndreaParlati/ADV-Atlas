    "# ── Section 1: imports and CONFIG\n",
    "import os, sys, zipfile, warnings\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import xarray as xr\n",
    "from pathlib import Path\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "warnings.filterwarnings(\"ignore\", category=RuntimeWarning)\n",
    "\n",
    "# ── Paths (all relative to the project folder COP_hackathon/)\n",
    "DATA_DIR    = Path(\"data\")\n",
    "FIGURES_DIR = Path(\"figures\")\n",
    "DATA_DIR.mkdir(exist_ok=True)\n",
    "FIGURES_DIR.mkdir(exist_ok=True)\n",
    "\n",
    "# Folders scanned for NetCDF input (as written by download_data.ipynb)\n",
    "SEARCH_DIRS = [DATA_DIR, Path(\"Wave_Reanalysis\"), Path(\"ERA5\"),\n",
    "               Path(\"Physics_Reanalysis\"), Path(\"L4_altimetry\")]\n",
    "\n",
    "# ── ship_physics (Phase 1, Eq. 1-18 flag)\n",
    "sys.path.insert(0, str(Path(\"ship_physics\")))\n",
    "try:\n",
    "    from ship_physics import is_hazardous_event   # Eq. 1-18 flag (needs RAOs, Phase 1)\n",
    "    import ship_physics as sp\n",
    "    print(f\"ship_physics loaded: heave thresh {sp.HEAVE_THRESHOLD_SIG_M} m, \"\n",
    "          f\"roll thresh {sp.ROLL_THRESHOLD_SIG_DEG} deg, abnormality {sp.ABNORMALITY_INDEX}\")\n",
    "except Exception as exc:\n",
    "    is_hazardous_event, sp = None, None\n",
    "    print(f\"WARNING: ship_physics not importable ({exc}); Hs proxies only.\")\n",
    "\n",
    "# ════════════════════════════ CONFIG ════════════════════════════\n",
    "# ── Time range (wave reanalysis available locally for 2010-2020)\n",
    "YEAR_START, YEAR_END = 2010, 2020\n",
    "\n",
    "# ── Route: Lisbon (38.7°N, -9.1°E) → Halifax (44.7°N, -63.6°E)\n",
    "N_ROUTE_PTS  = 60\n",
    "ROUTE_LONS   = np.linspace(-9.1, -63.6, N_ROUTE_PTS)\n",
    "ROUTE_LATS   = np.linspace(38.7,  44.7, N_ROUTE_PTS)\n",
    "\n",
    "# ── Hazard thresholds\n",
    "HEAVE_THRESH_M   = 3.5     # significant wave height proxy [m]\n",
    "ROGUE_HS_PROXY   = 6.0     # Hs threshold as rogue-wave likelihood proxy\n",
    "                           # (H_max/Hs > 2 equivalent on grid-Hs)\n",
    "                           # replace with full abnormality index when\n",
    "                           # RAOs are available from Phase 1\n",
    "\n",
    "# ── 5-degree longitude bins for spatial stratification\n",
    "LON_BIN_EDGES = np.arange(-65, -4, 5)   # [-65,-60,...,-10,-5]\n",
    "\n",
    "# ── Variable-name candidates (resolved against FOUND_FILES, first match wins)\n",
    "HS_CANDIDATES  = [\"VHM0\", \"hs\", \"swh\", \"significant_wave_height\"]\n",
    "T0_CANDIDATES  = [\"VTPK\", \"tp\", \"pp1d\", \"peak_period\"]\n",
    "T0_FALLBACKS   = [\"VTM10\", \"mwp\"]          # mean periods, used only if no peak period exists\n",
    "WIND_U_V       = (\"u10\", \"v10\")\n",
    "TIME_CANDIDATES = [\"time\", \"valid_time\"]\n",
    "\n",
    "# ── CMEMS live-download fallback (used only for years with no local wave file)\n",
    "WAVE_DATASET_ID = \"cmems_mod_glo_wav_my_0.2deg_PT3H-i\"\n",
    "try:\n",
    "    from dotenv import load_dotenv     # picks up CMEMS_USERNAME / CMEMS_PASSWORD from .env\n",
    "    load_dotenv()\n",
    "except ImportError:\n",
    "    pass\n",
    "CMEMS_USER = os.getenv(\"CMEMS_USERNAME\", \"YOUR_USERNAME\")\n",
    "CMEMS_PASS = os.getenv(\"CMEMS_PASSWORD\", \"YOUR_PASSWORD\")\n",
    "# ════════════════════════════════════════════════════════════════\n",
    "\n",
    "print(f\"Years {YEAR_START}-{YEAR_END} | {N_ROUTE_PTS} route points | \"\n",
    "      f\"heave > {HEAVE_THRESH_M} m | rogue proxy > {ROGUE_HS_PROXY} m | \"\n",
    "      f\"CMEMS credentials {'set' if CMEMS_USER != 'YOUR_USERNAME' else 'NOT set'}\")"
   ]
